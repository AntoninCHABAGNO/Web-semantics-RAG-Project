@prefix qg:   <http://example.org/qg#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/qg> a owl:Ontology ;
  rdfs:label "The Queen's Gambit Ontology" ;
  rdfs:comment "Ontology for The Queen's Gambit domain: characters, real persons, events, works, organizations, and extracted relations." .

#################################################################
# Classes
#################################################################

qg:Thing a owl:Class ;
  rdfs:label "Entity" .

qg:Agent a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Agent" .

qg:Person a owl:Class ;
  rdfs:subClassOf qg:Agent ;
  rdfs:label "Person" .

qg:Character a owl:Class ;
  rdfs:subClassOf qg:Person ;
  rdfs:label "Character" ;
  rdfs:comment "Fictional character." .

qg:RealPerson a owl:Class ;
  rdfs:subClassOf qg:Person ;
  rdfs:label "Real Person" ;
  rdfs:comment "Real-world person." .

qg:Organization a owl:Class ;
  rdfs:subClassOf qg:Agent ;
  rdfs:label "Organization" .

qg:Group a owl:Class ;
  rdfs:subClassOf qg:Agent ;
  rdfs:label "Group" .

qg:Place a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Place" .

qg:Location a owl:Class ;
  rdfs:subClassOf qg:Place ;
  rdfs:label "Location" .

qg:Event a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Event" .

qg:Tournament a owl:Class ;
  rdfs:subClassOf qg:Event ;
  rdfs:label "Tournament" .

qg:Game a owl:Class ;
  rdfs:subClassOf qg:Event ;
  rdfs:label "Game" ;
  rdfs:comment "Chess game." .

qg:Work a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Work" .

qg:Series a owl:Class ;
  rdfs:subClassOf qg:Work ;
  rdfs:label "Series" .

qg:Episode a owl:Class ;
  rdfs:subClassOf qg:Work ;
  rdfs:label "Episode" .

qg:Book a owl:Class ;
  rdfs:subClassOf qg:Work ;
  rdfs:label "Book" .

qg:ChessOpening a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Chess Opening" .

#################################################################
# Datatype properties
#################################################################

qg:sourceUrl a owl:DatatypeProperty ;
  rdfs:label "Source URL" ;
  rdfs:domain qg:Thing ;
  rdfs:range xsd:anyURI .

qg:confidence a owl:DatatypeProperty ;
  rdfs:label "confidence" ;
  rdfs:comment "Confidence score of extraction." ;
  rdfs:domain rdf:Statement ;
  rdfs:range xsd:decimal .

qg:evidence a owl:DatatypeProperty ;
  rdfs:label "text evidence" ;
  rdfs:domain rdf:Statement ;
  rdfs:range xsd:string .

qg:evidenceStartChar a owl:DatatypeProperty ;
  rdfs:label "evidence start char" ;
  rdfs:domain rdf:Statement ;
  rdfs:range xsd:integer .

qg:evidenceEndChar a owl:DatatypeProperty ;
  rdfs:label "evidence end char" ;
  rdfs:domain rdf:Statement ;
  rdfs:range xsd:integer .

#################################################################
# Object properties — social / narrative
#################################################################

qg:met a owl:ObjectProperty ;
  rdfs:label "met" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

qg:helped a owl:ObjectProperty ;
  rdfs:label "helped" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

qg:supported a owl:ObjectProperty ;
  rdfs:label "supported" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

qg:befriended a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:label "befriended" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

qg:loved a owl:ObjectProperty ;
  rdfs:label "loved" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

qg:married a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:label "married" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

qg:divorced a owl:ObjectProperty ;
  rdfs:label "divorced" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

#################################################################
# Object properties — training / learning
#################################################################

qg:trainedBy a owl:ObjectProperty ;
  rdfs:label "trained by" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

qg:coachedBy a owl:ObjectProperty ;
  rdfs:label "coached by" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

qg:taughtBy a owl:ObjectProperty ;
  rdfs:label "taught by" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

qg:learnedFrom a owl:ObjectProperty ;
  rdfs:label "learned from" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

#################################################################
# Object properties — family
#################################################################

qg:parentOf a owl:ObjectProperty ;
  rdfs:label "parent of" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person ;
  owl:inverseOf qg:childOf .

qg:childOf a owl:ObjectProperty ;
  rdfs:label "child of" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

qg:siblingOf a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:label "sibling of" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person .

#################################################################
# Object properties — chess participation / results
#################################################################

qg:participatedIn a owl:ObjectProperty ;
  rdfs:label "participated in" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Event .

qg:competedIn a owl:ObjectProperty ;
  rdfs:label "competed in" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Event ;
  rdfs:subPropertyOf qg:participatedIn .

qg:entered a owl:ObjectProperty ;
  rdfs:label "entered" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Tournament ;
  rdfs:subPropertyOf qg:participatedIn .

qg:playedIn a owl:ObjectProperty ;
  rdfs:label "played in" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Event ;
  rdfs:subPropertyOf qg:participatedIn .

qg:played a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:label "played against" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person ;
  rdfs:comment "General symmetric relation 'played against'." .

qg:defeated a owl:ObjectProperty ;
  rdfs:label "defeated" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person ;
  rdfs:subPropertyOf qg:played ;
  owl:inverseOf qg:lostTo .

qg:lostTo a owl:ObjectProperty ;
  rdfs:label "lost to" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person ;
  rdfs:subPropertyOf qg:played .

qg:drewWith a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:label "drew with" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Person ;
  rdfs:subPropertyOf qg:played .

qg:won a owl:ObjectProperty ;
  rdfs:label "won" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Event ;
  owl:inverseOf qg:wonBy .

qg:wonBy a owl:ObjectProperty ;
  rdfs:label "won by" ;
  rdfs:domain qg:Event ;
  rdfs:range qg:Person .

qg:lost a owl:ObjectProperty ;
  rdfs:label "lost" ;
  rdfs:domain qg:Person ;
  rdfs:range qg:Event ;
  owl:inverseOf qg:lostBy .

qg:lostBy a owl:ObjectProperty ;
  rdfs:label "lost by" ;
  rdfs:domain qg:Event ;
  rdfs:range qg:Person .

qg:hasGame a owl:ObjectProperty ;
  rdfs:label "has game" ;
  rdfs:domain qg:Tournament ;
  rdfs:range qg:Game .

qg:inTournament a owl:ObjectProperty ;
  rdfs:label "in tournament" ;
  rdfs:domain qg:Game ;
  rdfs:range qg:Tournament ;
  owl:inverseOf qg:hasGame .

qg:hasPlayer a owl:ObjectProperty ;
  rdfs:label "has player" ;
  rdfs:domain qg:Game ;
  rdfs:range qg:Person .

qg:usedOpening a owl:ObjectProperty ;
  rdfs:label "used opening" ;
  rdfs:domain qg:Game ;
  rdfs:range qg:ChessOpening .

#################################################################
# Object properties — works / episodes
#################################################################

qg:partOfSeries a owl:ObjectProperty ;
  rdfs:label "part of series" ;
  rdfs:domain qg:Episode ;
  rdfs:range qg:Series ;
  owl:inverseOf qg:hasEpisode .

qg:hasEpisode a owl:ObjectProperty ;
  rdfs:label "has episode" ;
  rdfs:domain qg:Series ;
  rdfs:range qg:Episode .

#################################################################
# Object properties — context
#################################################################

qg:tookPlaceIn a owl:ObjectProperty ;
  rdfs:label "took place in" ;
  rdfs:domain qg:Event ;
  rdfs:range qg:Place .