@prefix qg:   <http://example.org/qg#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontologie — Le Jeu de la Dame / The Queen’s Gambit
#################################################################

qg:Ontology a owl:Ontology ;
  rdfs:label "Ontologie Le Jeu de la Dame (Queen’s Gambit)"@fr ;
  rdfs:comment "Ontologie minimale pour représenter personnages, tournois, parties d’échecs et relations extraites."@fr .

#################################################################
# Classes
#################################################################

qg:Thing a owl:Class ;
  rdfs:label "Entité"@fr .

qg:Agent a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Agent"@fr .

qg:Person a owl:Class ;
  rdfs:subClassOf qg:Agent ;
  rdfs:label "Personne"@fr .

qg:Character a owl:Class ;
  rdfs:subClassOf qg:Person ;
  rdfs:label "Personnage"@fr ;
  rdfs:comment "Personnage fictionnel (ex: Beth Harmon)."@fr .

qg:RealPerson a owl:Class ;
  rdfs:subClassOf qg:Person ;
  rdfs:label "Personne réelle"@fr ;
  rdfs:comment "Personne réelle (ex: joueurs historiques mentionnés)."@fr .

qg:Organization a owl:Class ;
  rdfs:subClassOf qg:Agent ;
  rdfs:label "Organisation"@fr .

qg:Place a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Lieu"@fr .

qg:Location a owl:Class ;
  rdfs:subClassOf qg:Place ;
  rdfs:label "Localisation"@fr .

qg:Event a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Événement"@fr .

qg:Tournament a owl:Class ;
  rdfs:subClassOf qg:Event ;
  rdfs:label "Tournoi"@fr .

qg:Game a owl:Class ;
  rdfs:subClassOf qg:Event ;
  rdfs:label "Partie"@fr ;
  rdfs:comment "Partie d’échecs (peut être liée à un tournoi)."@fr .

qg:Work a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Œuvre"@fr ;
  rdfs:comment "Série, livre, etc."@fr .

qg:Episode a owl:Class ;
  rdfs:subClassOf qg:Work ;
  rdfs:label "Épisode"@fr .

qg:Book a owl:Class ;
  rdfs:subClassOf qg:Work ;
  rdfs:label "Livre"@fr .

qg:ChessOpening a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Ouverture d’échecs"@fr .

qg:Title a owl:Class ;
  rdfs:subClassOf qg:Thing ;
  rdfs:label "Titre"@fr ;
  rdfs:comment "Titre/grade (ex: champion, maître, etc.), si tu choisis de le représenter."@fr .

#################################################################
# Propriétés d’annotation (labels, sources)
#################################################################

qg:sourceUrl a owl:DatatypeProperty ;
  rdfs:label "URL source"@fr ;
  rdfs:domain qg:Thing ;
  rdfs:range xsd:anyURI .

#################################################################
# Object properties — relations entre entités
#################################################################

# Relations sociales / narratives
qg:met a owl:ObjectProperty ;
  rdfs:label "a rencontré"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

qg:helped a owl:ObjectProperty ;
  rdfs:label "a aidé"@fr ;
  rdfs:domain qg:Agent ;
  rdfs:range  qg:Agent .

qg:supported a owl:ObjectProperty ;
  rdfs:label "a soutenu"@fr ;
  rdfs:domain qg:Agent ;
  rdfs:range  qg:Agent .

qg:befriended a owl:ObjectProperty ;
  rdfs:label "s'est lié d'amitié avec"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

qg:loved a owl:ObjectProperty ;
  rdfs:label "a aimé"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

qg:married a owl:ObjectProperty ;
  rdfs:label "a épousé"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

qg:divorced a owl:ObjectProperty ;
  rdfs:label "a divorcé de"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

# Entraînement / apprentissage
qg:trainedBy a owl:ObjectProperty ;
  rdfs:label "a été entraîné par"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

qg:coachedBy a owl:ObjectProperty ;
  rdfs:label "a été coaché par"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

qg:taughtBy a owl:ObjectProperty ;
  rdfs:label "a été enseigné par"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

qg:learnedFrom a owl:ObjectProperty ;
  rdfs:label "a appris de"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

# Famille
qg:parentOf a owl:ObjectProperty ;
  rdfs:label "est parent de"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person ;
  owl:inverseOf qg:childOf .

qg:childOf a owl:ObjectProperty ;
  rdfs:label "est enfant de"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

qg:siblingOf a owl:ObjectProperty ;
  rdfs:label "est frère/sœur de"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person ;
  a owl:SymmetricProperty .

# Échecs — participation / résultats
qg:competedIn a owl:ObjectProperty ;
  rdfs:label "a participé à"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Event .

qg:entered a owl:ObjectProperty ;
  rdfs:label "s'est inscrit à"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Tournament .

qg:playedIn a owl:ObjectProperty ;
  rdfs:label "a joué dans"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Event .

qg:played a owl:ObjectProperty ;
  rdfs:label "a joué contre"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person ;
  a owl:SymmetricProperty ;
  rdfs:comment "Relation générale 'a joué contre' (symétrique)."@fr .

qg:defeated a owl:ObjectProperty ;
  rdfs:label "a battu"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person ;
  owl:inverseOf qg:lostTo .

qg:lostTo a owl:ObjectProperty ;
  rdfs:label "a perdu contre"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person .

qg:drewWith a owl:ObjectProperty ;
  rdfs:label "a fait match nul avec"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Person ;
  a owl:SymmetricProperty .

qg:won a owl:ObjectProperty ;
  rdfs:label "a gagné"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Event .

qg:lost a owl:ObjectProperty ;
  rdfs:label "a perdu"@fr ;
  rdfs:domain qg:Person ;
  rdfs:range  qg:Event .

qg:hasGame a owl:ObjectProperty ;
  rdfs:label "a pour partie"@fr ;
  rdfs:domain qg:Tournament ;
  rdfs:range  qg:Game .

qg:inTournament a owl:ObjectProperty ;
  rdfs:label "se déroule dans le tournoi"@fr ;
  rdfs:domain qg:Game ;
  rdfs:range  qg:Tournament ;
  owl:inverseOf qg:hasGame .

qg:hasPlayer a owl:ObjectProperty ;
  rdfs:label "a pour joueur"@fr ;
  rdfs:domain qg:Game ;
  rdfs:range  qg:Person .

qg:usedOpening a owl:ObjectProperty ;
  rdfs:label "a utilisé l'ouverture"@fr ;
  rdfs:domain qg:Game ;
  rdfs:range  qg:ChessOpening .

# Localisation / contexte
qg:tookPlaceIn a owl:ObjectProperty ;
  rdfs:label "a eu lieu à"@fr ;
  rdfs:domain qg:Event ;
  rdfs:range  qg:Place .

qg:associatedWithWork a owl:ObjectProperty ;
  rdfs:label "associé à l'œuvre"@fr ;
  rdfs:domain qg:Thing ;
  rdfs:range  qg:Work .

#################################################################
# Datatype properties — attributs simples
#################################################################

qg:confidence a owl:DatatypeProperty ;
  rdfs:label "confiance"@fr ;
  rdfs:comment "Score de confiance de l'extraction (0..1 ou 0..100 selon ton pipeline)."@fr ;
  rdfs:domain rdf:Statement ;
  rdfs:range xsd:decimal .

qg:evidence a owl:DatatypeProperty ;
  rdfs:label "preuve textuelle"@fr ;
  rdfs:domain rdf:Statement ;
  rdfs:range xsd:string .

qg:evidenceStartChar a owl:DatatypeProperty ;
  rdfs:label "début preuve (caractère)"@fr ;
  rdfs:domain rdf:Statement ;
  rdfs:range xsd:integer .

qg:evidenceEndChar a owl:DatatypeProperty ;
  rdfs:label "fin preuve (caractère)"@fr ;
  rdfs:domain rdf:Statement ;
  rdfs:range xsd:integer .