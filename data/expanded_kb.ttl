[] a rdf:Statement ;
    qg:confidence 0.75 ;
    qg:evidence "Beth easily defeats Annette to the surprise of the twins and a fellow player D.L. Townes, whom she briefly chatted with before her first match." ;
    qg:evidenceEndChar 11390 ;
    qg:evidenceStartChar 11247 ;
    rdf:object qg:character_annette_packer_8f7265 ;
    rdf:predicate qg:defeated ;
    rdf:subject qg:character_beth_harmon_0c125c .

[] a rdf:Statement ;
    qg:confidence 0.71 ;
    qg:evidence "Although, when she goes to Paris she meets up with Cloe and Cloe asks her if she liked having sex with Benny, and Beth responds with \"Sometimes.\"" ;
    qg:evidenceEndChar 15776 ;
    qg:evidenceStartChar 15631 ;
    rdf:object qg:character_cleo_25511b ;
    rdf:predicate qg:met ;
    rdf:subject qg:character_beth_harmon_0c125c .

[] a rdf:Statement ;
    qg:confidence 0.75 ;
    qg:evidence "3 years later, She finds herself in the Las Vegas U.S. Open Chess Championship (1966), she meets Townes again and he offers to picture her for an issue of the Sunday paper." ;
    qg:evidenceEndChar 21787 ;
    qg:evidenceStartChar 21615 ;
    rdf:object qg:character_d_l_townes_a69829 ;
    rdf:predicate qg:met ;
    rdf:subject qg:character_beth_harmon_0c125c .

