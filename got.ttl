@prefix : <http://example.org/got#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/got#> .

<http://example.org/got> rdf:type owl:Ontology ;
                          rdfs:comment "Lightweight ontology for a GoT knowledge graph extracted from web pages. TBox only (schema)."@en ;
                          rdfs:label "Game of Thrones / AWOIAF mini-ontology (light)"@en .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/got#alliedWith
:alliedWith rdf:type owl:ObjectProperty ,
                     owl:SymmetricProperty ;
            rdfs:domain :Group ;
            rdfs:range :Group ;
            rdfs:comment "Alliance relation between Houses/Organizations."@en ;
            rdfs:label "alliedWith"@en .


###  http://example.org/got#childOf
:childOf rdf:type owl:ObjectProperty ;
         owl:inverseOf :parentOf ;
         rdf:type owl:AsymmetricProperty ,
                  owl:IrreflexiveProperty ;
         rdfs:domain :Character ;
         rdfs:range :Character ;
         rdfs:comment "Parent/child relation between characters."@en ;
         rdfs:label "childOf"@en .


###  http://example.org/got#killed
:killed rdf:type owl:ObjectProperty ,
                 owl:AsymmetricProperty ,
                 owl:IrreflexiveProperty ;
        rdfs:domain :Character ;
        rdfs:range :Character ;
        rdfs:comment "Character killed another character."@en ;
        rdfs:label "killed"@en .


###  http://example.org/got#locatedIn
:locatedIn rdf:type owl:ObjectProperty ,
                    owl:TransitiveProperty ;
           rdfs:domain :Place ;
           rdfs:range :Place ;
           rdfs:comment "Place is located in another place (can be transitive)."@en ;
           rdfs:label "locatedIn"@en .


###  http://example.org/got#marriedTo
:marriedTo rdf:type owl:ObjectProperty ,
                    owl:SymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :Character ;
           rdfs:range :Character ;
           rdfs:comment "Marriage relation between characters (symmetric)."@en ;
           rdfs:label "marriedTo"@en .


###  http://example.org/got#memberOf
:memberOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Character ;
          rdfs:range :House ;
          rdfs:comment "Character is a member of a House."@en ;
          rdfs:label "memberOf"@en .


###  http://example.org/got#parentOf
:parentOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Character ;
          rdfs:range :Character ;
          rdfs:comment "Inverse of childOf."@en ;
          rdfs:label "parentOf"@en .


###  http://example.org/got#rules
:rules rdf:type owl:ObjectProperty ;
       rdfs:domain :Character ;
       rdfs:range :Place ;
       rdfs:comment "Character rules a place."@en ;
       rdfs:label "rules"@en .


#################################################################
#    Data properties
#################################################################

###  http://example.org/got#canonicalName
:canonicalName rdf:type owl:DatatypeProperty ;
               rdfs:domain :Entity ;
               rdfs:range xsd:string ;
               rdfs:comment "Canonical label for an entity (normalized text)."@en ;
               rdfs:label "canonicalName"@en .


###  http://example.org/got#confidence
:confidence rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :canonicalName ;
            rdfs:domain owl:Thing ;
            rdfs:range xsd:float ;
            rdfs:comment "Extraction confidence (0..1)."@en ;
            rdfs:label "confidence"@en .


###  http://example.org/got#evidenceEnd
:evidenceEnd rdf:type owl:DatatypeProperty ;
             rdfs:domain owl:Thing ;
             rdfs:range xsd:integer ;
             rdfs:comment "End character offset of evidence in page text."@en ;
             rdfs:label "evidenceEnd"@en .


###  http://example.org/got#evidenceStart
:evidenceStart rdf:type owl:DatatypeProperty ;
               rdfs:domain owl:Thing ;
               rdfs:range xsd:integer ;
               rdfs:comment "Start character offset of evidence in page text."@en ;
               rdfs:label "evidenceStart"@en .


###  http://example.org/got#evidenceText
:evidenceText rdf:type owl:DatatypeProperty ;
              rdfs:domain owl:Thing ;
              rdfs:range xsd:string ;
              rdfs:comment "Evidence sentence/snippet supporting a fact."@en ;
              rdfs:label "evidenceText"@en .


###  http://example.org/got#sourceUrl
:sourceUrl rdf:type owl:DatatypeProperty ;
           rdfs:domain :Entity ;
           rdfs:range xsd:anyURI ;
           rdfs:comment "Source URL from which the entity/fact was extracted."@en ;
           rdfs:label "sourceUrl"@en .


#################################################################
#    Classes
#################################################################

###  http://example.org/got#Battle
:Battle rdf:type owl:Class ;
        rdfs:subClassOf :Event ;
        rdfs:label "Battle"@en .


###  http://example.org/got#Character
:Character rdf:type owl:Class ;
           rdfs:subClassOf :Person ;
           owl:disjointWith :RealPerson ;
           rdfs:comment "In-universe character."@en ;
           rdfs:label "Character"@en .


###  http://example.org/got#Entity
:Entity rdf:type owl:Class ;
        rdfs:comment "Top-level class for all domain entities."@en ;
        rdfs:label "Entity"@en .


###  http://example.org/got#Event
:Event rdf:type owl:Class ;
       rdfs:subClassOf :Entity ;
       owl:disjointWith :Group ,
                        :Person ,
                        :Place ,
                        :Work ;
       rdfs:label "Event"@en .


###  http://example.org/got#Group
:Group rdf:type owl:Class ;
       rdfs:subClassOf :Entity ;
       owl:disjointWith :Person ,
                        :Place ,
                        :Work ;
       rdfs:label "Group"@en .


###  http://example.org/got#House
:House rdf:type owl:Class ;
       rdfs:subClassOf :Group ;
       rdfs:label "House"@en .


###  http://example.org/got#Location
:Location rdf:type owl:Class ;
          rdfs:subClassOf :Place ;
          owl:disjointWith :Region ;
          rdfs:label "Location"@en .


###  http://example.org/got#Organization
:Organization rdf:type owl:Class ;
              rdfs:subClassOf :Group ;
              rdfs:label "Organization"@en .


###  http://example.org/got#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf :Entity ;
        owl:disjointWith :Place ,
                         :Work ;
        rdfs:label "Person"@en .


###  http://example.org/got#Place
:Place rdf:type owl:Class ;
       rdfs:subClassOf :Entity ;
       owl:disjointWith :Work ;
       rdfs:label "Place"@en .


###  http://example.org/got#RealPerson
:RealPerson rdf:type owl:Class ;
            rdfs:subClassOf :Person ;
            rdfs:comment "Real-world person (actor/author/etc.)."@en ;
            rdfs:label "RealPerson"@en .


###  http://example.org/got#Region
:Region rdf:type owl:Class ;
        rdfs:subClassOf :Place ;
        rdfs:label "Region"@en .


###  http://example.org/got#Work
:Work rdf:type owl:Class ;
      rdfs:subClassOf :Entity ;
      rdfs:comment "Book/series/work title."@en ;
      rdfs:label "Work"@en .


